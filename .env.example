
# Neon PostgreSQL
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=1
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=1800
# Disabled until deletion UX, offsite erasure replay and production review are complete.
ACCOUNT_DELETION_ENABLED=false

# Groq AI
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-120b

# Reviewed source editions; pending/restricted registry entries cannot be enabled by env alone.
QURAN_ARABIC_EDITION=quran-uthmani
QURAN_EDITION_EN=en.itani
QURAN_EDITION_UZ=
QURAN_EDITION_RU=

# Authentication
JWT_SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
AUTH_COOKIE_SECURE=false
AUTH_TRUSTED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]
TRUSTED_PROXY_CIDRS=[]

# AI operations: illustrative estimates, verify against the provider before launch
MAX_GLOBAL_AI_GENERATIONS=10
AI_DAILY_BUDGET_USD=2
AI_MONTHLY_BUDGET_USD=20
AI_INPUT_USD_PER_MILLION=1
AI_OUTPUT_USD_PER_MILLION=2
AI_MAX_PROVIDER_ATTEMPTS=6
AI_MAX_INPUT_TOKENS=16384
AI_PLANNER_OUTPUT_TOKENS=2048
AI_MAX_OUTPUT_TOKENS=4096

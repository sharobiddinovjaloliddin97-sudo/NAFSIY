# Template only; use separate secrets and database from primary and shared test.
APP_ENV=staging
DATABASE_URL=postgresql+psycopg://RUNTIME_ROLE:PASSWORD@STAGING_HOST/STAGING_DB?sslmode=require
MIGRATION_DATABASE_URL=postgresql+psycopg://OWNER_ROLE:PASSWORD@STAGING_DIRECT_HOST/STAGING_DB?sslmode=require
PUBLIC_WEB_URL=https://REPLACE_STAGING_HOST
AUTH_TRUSTED_ORIGINS=["https://REPLACE_STAGING_HOST"]
CORS_ORIGINS=["https://REPLACE_STAGING_HOST"]
AUTH_COOKIE_SECURE=true
JWT_SECRET_KEY=REPLACE_WITH_48_OR_MORE_RANDOM_CHARACTERS
TRUSTED_PROXY_CIDRS=[]
ACCOUNT_DELETION_ENABLED=false
REQUIRE_EMAIL_VERIFICATION=true

# Email delivery: 'resend' for Render Free (HTTPS port 443; ports 25/465/587 blocked) or 'smtp' for paid plans.
EMAIL_MODE=resend
EMAIL_FROM=
# When EMAIL_MODE=resend:
RESEND_API_KEY=
# When EMAIL_MODE=smtp:
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Staging public-backend gate secret (required for zero-budget free staging; min 32 chars).
# Injected by Next.js proxy into X-Staging-Proxy-Secret header; validated by FastAPI middleware.
STAGING_PROXY_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS

# AI Provider (Groq free tier)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
MAX_GLOBAL_AI_GENERATIONS=2
AI_INPUT_USD_PER_MILLION=0.15
AI_OUTPUT_USD_PER_MILLION=0.60
AI_DAILY_BUDGET_USD=2
AI_MONTHLY_BUDGET_USD=20

# Frontend server only; no NEXT_PUBLIC secret variables.
# For paid pserv: http://REPLACE_PRIVATE_API_HOST:10000
# For free web service: https://REPLACE_STAGING_API_HOST.onrender.com (HTTPS only, never plain HTTP)
API_INTERNAL_URL=https://REPLACE_STAGING_API_HOST.onrender.com
STAGING_ACCESS_USER=
STAGING_ACCESS_PASSWORD=

# External backup runner only; never give backup keys to app runtime.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
